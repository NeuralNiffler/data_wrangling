# Auto detect text files and perform LF normalization
* text=auto

# 2. Erzwinge LF (Unix) für Quellcode, damit Windows-Nutzer nichts zerschießen
*.js      text eol=lf
*.py      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf

# 3. Spezielle Windows-Dateien (falls vorhanden) auf CRLF lassen
*.bat     text eol=crlf
*.ps1     text eol=crlf

# 4. Binärdateien explizit markieren (werden nicht verändert)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.ico     binary
